{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ESNext",
    "jsx": "react-jsx",
    "checkJs": false,
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@content/*": ["src/content/*"],
      "@domain/*": ["src/domain/*"],
      "@features/*": ["src/features/*"],
      "@i18n/*": ["src/i18n/*"],
      "@services/*": ["src/services/*"],
      "@shared/*": ["src/shared/*"],
      "@styles/*": ["src/styles/*"]
    }
  },
  "include": ["src/**/*", "*.config.js", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}
